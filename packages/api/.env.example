APP_URL=http://localhost
ALLOWED_USERS=auth0|0123456789abcdef
AUTH0_DOMAIN=your-tenant.us.auth0.com
CORS_ALLOWED_ORIGIN=http://example.com
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=test
DB_NAME=postgres
DB_SSL=0
NODE_ENV=development
ENCRYPTION_KEY=abcdef0123456789
# Comma-separated list of integrations to enable (currently: skylight). See the README.
INTEGRATIONS=
# Accept mock credentials, for local development & tests only. Never enable in production.
# MOCK_AUTH=true
OPENID_CLIENT_ID=2fabc054-921d-4cd6-b75a-0556718a1ef7
OPENID_CLIENT_SECRET=2f7e93b5-46bb-4c43-97e3-e76d6fc856ed
OPENID_AUDIENCE=https://api.example.com
OPENID_URL=https://openid.example.com
RATE_LIMITING_WINDOW=900000
RATE_LIMITING_MAX=100
RATE_LIMITING_IPV6_SUBNET=56
WORK_CHUNK_SIZE=30
# Skylight integration (only needed if "skylight" is in INTEGRATIONS)
# Credentials: either a refresh token + device fingerprint (recommended), or a fixed auth header.
# SKYLIGHT_REFRESH_TOKEN=REPLACE_ME
# SKYLIGHT_DEVICE_FINGERPRINT=REPLACE_ME
# SKYLIGHT_AUTH_HEADER=Basic REPLACE_ME
# SKYLIGHT_FRAME_ID=1234567
# SKYLIGHT_CATEGORY_ID=7654321
# SKYLIGHT_COMPLETED_BY_CATEGORY_ID=7654321
# SKYLIGHT_TIMEZONE=America/Chicago
# SKYLIGHT_API_URL=https://app.ourskylight.com/api
# SKYLIGHT_API_VERSION=2026-08-05
# SKYLIGHT_OAUTH_URL=https://app.ourskylight.com/oauth/token
# SKYLIGHT_OAUTH_CLIENT_ID=skylight-mobile
